# AWS S3 Configuration
# Copy this file to .env and fill in your actual values
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
S3_BUCKET=your_bucket_name_here

# Optional CSV API upload configuration
# If CSV_UPLOAD_API_URL is set, each generated CSV will also be sent via HTTP POST (multipart/form-data)
CSV_UPLOAD_API_URL=
CSV_UPLOAD_API_TOKEN=
CSV_UPLOAD_TIMEOUT_MS=30000
CSV_UPLOAD_FIELD_NAME=file

# Optional upload tracking APIs (GET)
UPLOAD_START_API_URL=
UPLOAD_END_API_URL=
UPLOAD_TRACKING_TIMEOUT_MS=30000

# Upload tuning for large batches
UPLOAD_CONCURRENCY=4
FILE_LIST_PREVIEW_LIMIT=300
