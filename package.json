{
  "name": "ruzzo-electron-s3-uploader",
  "version": "1.0.0",
  "description": "Electron app to upload files Ruzzo to Amazon S3",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder -p always"
  },
  "author": "AlexOlivieri",
  "license": "MIT",
  "build": {
    "appId": "com.giano.s3uploader",
    "productName": "PushRuzzo S3 Uploader",
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PushRuzzo S3 Uploader"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://gestionale.mediaprint.it/ElectronAppUpdate/ruzzo-electron-s3-uploader/"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "node_modules/**/*",
      ".env.example"
    ]
  },
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.400.0",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.8.3",
    "winston": "^3.10.0"
  }
}
